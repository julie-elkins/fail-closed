{
  "theme": "dark",
  "model": "opus",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add :/*)",
      "Bash(git add .)",
      "Bash(git add ./)",
      "Bash(git add -u)",
      "Bash(git add --update)",
      "Bash(git stage -A*)",
      "Bash(git stage --all*)",
      "Bash(git stage .)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 <CLAUDE_HOME>/hooks/refuse-dangerous-staging.py",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
